# --- Telegram ---
BOT_TOKEN=
BOT_USERNAME=PadelFirst_bot

# Чат админа (личка) — куда падают уведомления о новых записях
ADMIN_CHAT_ID=212659753

# Группа клуба, где живёт анонс турниров. Обычно отрицательное число вида -1001234567890.
# Можно переопределить per-tournament в content.md (поле group_chat_id).
GROUP_CHAT_ID=

# --- Хранилище ---
DB_PATH=padel.db

# --- Google Sheets ---
# ID таблицы — кусок URL между /d/ и /edit
GOOGLE_SHEET_ID=

# Передайте либо путь к JSON service-account...
GOOGLE_CREDENTIALS_PATH=credentials.json
# ...либо целый JSON одной строкой (удобно для Render)
GOOGLE_CREDENTIALS_JSON=

# Не забудьте расшарить таблицу на client_email из JSON service-account
# с правами Editor, иначе gspread не сможет писать.

# --- Опционально (для Render Web Service) ---
# Если задан PORT — поднимется фейковый http-сервер для healthcheck
# PORT=10000
